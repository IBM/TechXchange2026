# FleetOps Forecasting Service - Environment Variables

# ── IBM Vault (AppRole) — used by fleetops-backend, not this service ──────────
# These vars are consumed by fleetops-backend at startup to fetch webMethods
# credentials from Vault.  Set them here only if you are running all services
# from the same shell environment.  Other services may use these in the future.
# VAULT_ADDR=https://<vault-host>:8200
# VAULT_ROLE_ID=<your-approle-role-id>
# VAULT_SECRET_ID=<your-approle-secret-id>
# VAULT_REQUIRED=false   # set true in production to fail fast if Vault unreachable
# VAULT_TLS_VERIFY=false # set false only when Vault uses a self-signed certificate

# Server Configuration
# Bind to localhost only — NEVER 0.0.0.0 (would expose the service on all interfaces)
SERVER_HOST=127.0.0.1
SERVER_PORT=5001

# FleetOps Backend API URL
FLEETOPS_API_BASE_URL=https://<fleetops-api-route>.<cluster-domain>

# TTM Model Configuration
CONTEXT_LENGTH=512
PREDICTION_LENGTH=96
FREQUENCY=1min
# Note: Use pandas frequency strings (lowercase): 1min, 5min, 15min, 1h, 1d
# NOT: 1H (uppercase H is invalid)

# Model Settings
USE_TTM_MODEL=False
TTM_MODEL_PATH=ibm-granite/granite-timeseries-ttm-r2
TTM_MODEL_REVISION=main
DEVICE=cpu

# ── Phase 1 (revised): IBM watsonx.ai native serverless inference ────────────
# No deployment needed — ibm/granite-ttm-512-96-r2 is IBM-hosted.
# Set TTM_MODEL_ID to activate the native API path in TTMModelWrapper.
# Matches CONTEXT_LENGTH=512, PREDICTION_LENGTH=96, FREQUENCY=1min.
TTM_MODEL_ID=ibm/granite-ttm-512-96-r2
WML_SPACE_ID=<your-wml-space-id>
WML_API_KEY=<your-ibm-cloud-api-key>
# Region where your WML instance lives — used to construct the native API URL
IBM_CLOUD_REGION=us-south

# ── Phase 2 (governance): OpenScale payload logging ──────────────────────────
# Set to true after running governance/setup/provision.py — silently skipped
# until governance/artifacts/deployment.json contains real OpenScale IDs.
GOVERNANCE_PAYLOAD_LOGGING=true

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/forecasting-service.log