FLEETOPS_API_BASE_URL=http://localhost:8085
FREQUENCY=1min

# USE_TTM_MODEL=False  →  mock mode, instant startup, no model download (use for lab)
# USE_TTM_MODEL=True   →  real IBM Granite TTM-R2 via WML (requires WML credentials below)
USE_TTM_MODEL=False

# WML credentials — only required if USE_TTM_MODEL=True
WML_SPACE_ID=
WML_API_KEY=
IBM_CLOUD_REGION=us-south
