# FleetOps Application Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── IBM Vault (AppRole) — used by fleetops-backend, not this service ──────────
# These vars are consumed by fleetops-backend at startup to fetch webMethods
# credentials from Vault.  Set them here only if you are running all services
# from the same shell environment.  Other services may use these in the future.
# VAULT_ADDR=https://<vault-host>:8200
# VAULT_ROLE_ID=<your-approle-role-id>
# VAULT_SECRET_ID=<your-approle-secret-id>
# VAULT_REQUIRED=false   # set true in production to fail fast if Vault unreachable
# VAULT_TLS_VERIFY=false # set false only when Vault uses a self-signed certificate

# Server Configuration
PORT=4000
NODE_ENV=development

# ─── Required: Backend API URLs ──────────────────────────────────────────────
# URL of the fleetops-backend service (cold-chain API)
COLDCHAIN_API_URL=https://<fleetops-api-route>.<cluster-domain>

# URL of the forecast-backend service (TTM model API)
FORECAST_API_URL=https://<fleetops-forecasting-route>.<cluster-domain>

# URL of the Phase 2 pre-planning backend (fleet-state, alerts, forecast, bays)
PHASE2_BACKEND_URL=https://<fleetops-phase2-backend-route>.<cluster-domain>

# URL of the Agent Workflow Service (trigger, workflow state, approve-manifest)
AGENT_WORKFLOW_URL=https://<agent-workflow-backend-route>.<cluster-domain>

# ─── Governance (John Doe — Data Scientist persona) ──────────────────────────
# Model Governance FastAPI service (governance/api/governance_api.py, port 5002)
GOVERNANCE_API_URL=https://<fleetops-governance-api-route>.<cluster-domain>

# Agent Governance backend (fleetops-api)
AGENT_GOV_URL=https://<fleetops-api-route>.<cluster-domain>

# ─── Optional: Observe tab deep-link URLs ────────────────────────────────────
# These are shown as "Open in Instana / Turbonomic" links in the UI.
# Leave blank if you are not using those integrations.
INSTANA_URL=https://<your-instana-tenant>.instana.io
TURBONOMIC_URL=https://<your-turbonomic-host>/app/#/view/main/live/<entity-id>/overview

# ─── Optional: Instana API (backend calls for Observe tab metrics) ────────────
INSTANA_BASE_URL=https://<your-instana-tenant>.instana.io
INSTANA_API_TOKEN=<your-instana-api-token>
INSTANA_SERVICE_NAME=<service-name-as-registered-in-instana>
INSTANA_DEPLOYMENT_NAME=<kubernetes-deployment-name>
INSTANA_NAMESPACE=<kubernetes-namespace>
INSTANA_CLUSTER=<kubernetes-cluster-name>

# ─── Optional: Turbonomic API (backend calls for Observe tab actions) ─────────
# Note: Login uses the nginx-turbonomic host; the API uses a separate host.
TURBONOMIC_LOGIN_URL=https://<your-turbonomic-host>/api/v3/login
TURBONOMIC_API_URL=https://<your-turbonomic-api-host>/api/v3
TURBONOMIC_USERNAME=administrator
TURBONOMIC_PASSWORD=<your-turbonomic-password>
TURBONOMIC_DISPLAY_NAME=<deployment-display-name-in-turbonomic>
